#include <bits/stdc++.h>
using namespace std;
#define ll long long

bool check(ll mid, vector<ll> &heights, ll x) {
    ll units = 0;
    for (ll h : heights) {
        if (h < mid) {
            units += (mid - h);
            if (units > x) return false; // early break
        }
    }
    return true;
}

int main() {
    int t;
    cin >> t;

    while (t--) {
        ll n, x;
        cin >> n >> x;

        vector<ll> heights(n);
        for (int i = 0; i < n; i++) cin >> heights[i];

        ll si = 0;
        ll ei = *max_element(heights.begin(), heights.end()) + x;
        ll ans = 0;

        while (si <= ei) {
            ll mid = si + (ei - si) / 2;

            if (check(mid, heights, x)) {
                ans = mid;
                si = mid + 1;
            } else {
                ei = mid - 1;
            }
        }

        cout << ans << endl;
    }
}