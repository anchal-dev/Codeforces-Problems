#include<bits/stdc++.h>
using namespace std;


int main(){
    int t;
    cin>>t;
    while(t--){
        long long start,jumps;
        cin>>start>>jumps;
        
        long long r =jumps%4;
        long long delta =0;
        
        if(r==1)
        delta =-jumps;
        else if(r==2)
        delta =1;
        else if(r==3)
        delta = jumps +1;
        
        long long final_pos;
        if(start%2==0)
        final_pos = start+delta;
        else 
        final_pos = start-delta;
        
        cout << final_pos << "\n";
        
    }
    return 0;
}