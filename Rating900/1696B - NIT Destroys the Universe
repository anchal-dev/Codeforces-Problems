#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

int t;
cin>>t;
while(t--){
    int n;
    cin>>n;
    
    vector<int>a(n);
    for(int i=0;i<n;i++)
    cin>>a[i];
    
    int segments = 0;
    int i =0 ;
    
    while(i<n){
        if(a[i]!=0){
            segments++;
            while(i<n && a[i] != 0)
            i++;
        }
        else{
            i++;
        }
    }
    if(segments ==0)
    cout<<0<<endl;
    else if(segments ==1)
    cout<<1<<endl;
    else
    cout<<2<<endl;
}
}