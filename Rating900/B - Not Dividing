#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        long long n, q;
        cin >> n >> q;

        vector<long long> a(n);
        vector<long long> prefix(n + 1, 0);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
            prefix[i + 1] = prefix[i] + a[i];
        }

        long long total_sum = prefix[n];

        while (q--) {
            long long l, r, k;
            cin >> l >> r >> k;

            long long old_range_sum = prefix[r] - prefix[l - 1];
            long long length = r - l + 1;

            long long new_sum = total_sum - old_range_sum + length * k;

            if (new_sum % 2 != 0)
                cout << "YES\n";
            else
                cout << "NO\n";
        }
    }

    return 0;
}