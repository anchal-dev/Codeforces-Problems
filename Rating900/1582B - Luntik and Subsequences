#include<bits/stdc++.h>
using namespace std;

int main(){

    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    long long t;
    cin >> t;

    while(t--){
        long long n;
        cin >> n;

        vector<int> a(n);

        for(int i = 0; i < n; i++){
            cin >> a[i];
        }

        long long count_ones = 0;
        long long count_zeros = 0;

        for(int i = 0; i < n; i++){
            if(a[i] == 0){
                count_zeros++;
            }
            else if(a[i] == 1){
                count_ones++;
            }
        }

        long long ways = (1LL << count_zeros) * count_ones;

        cout << ways << endl;
    }

    return 0;
}