#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    
    cin >> t;
    
    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

       
       
        bool allEqual = true;
        
        for (int i = 1; i < n; i++) {
            if (a[i] != a[0]) {
                allEqual = false;
                break;
            }
        }

        if (allEqual) {
            cout << "NO\n";
            continue;
        }

        
        vector<int> ans;
        ans.push_back(a.back()); 

        for (int i = 0; i < n - 1; i++) {
            ans.push_back(a[i]);
        }

       
    
        long long prefix = 0;
        
        bool ok = true;
        for (int x : ans) {
            if (x == prefix) {
                ok = false;
                break;
            }
            prefix += x;
        }

        if (!ok) {
            cout << "NO\n";
        } else {
            cout << "YES\n";
            for (int x : ans) cout << x << " ";
            cout << "\n";
        }
    }
    return 0;
}
