#include<bits/stdc++.h>
using namespace std;

int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int current =0,maxi=0;
        for(int i=0;i<n;i++){
            int x;
            cin>>x;
            if(x==0){
                current++;
                maxi = max(maxi,current);
                
            }
            else{
                current =0;
            }
        }
        cout<<maxi<<"\n";
    }
    return 0;
}