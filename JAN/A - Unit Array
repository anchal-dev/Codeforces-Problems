#include<bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        
        int neg = 0;
        for(int i =0 ;i<n;i++){
            int x;
            cin>>x;
            if(x==-1)neg++;
        }
        int operations = 0;
        
         while(true){
        if(neg% 2==1){
            neg--;
            operations++;
        }
       else if(neg>n-neg){
            neg--;
            operations++;
        }
        else {
            break;
        }
        
    }
    cout<<operations<<"\n";
    }
    return 0;
}